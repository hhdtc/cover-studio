# Fine-grained GitHub token with "Contents: read" on hhdtc/cover-studio.
# Do not commit a real token.
GITHUB_TOKEN=

# Host port for the nginx service.
PORT=8080

# Optional: build a different branch/tag or fork.
REPO_URL=https://github.com/hhdtc/cover-studio.git
REPO_REF=main

# Optional Persona3-like-web demo port.
PERSONA3_PORT=5179
