# Host port for the nginx service.
PORT=8080

# Only used by docker-compose.remote.yml (clone-from-GitHub pipeline).
# Fine-grained token with "Contents: read" on hhdtc/cover-studio.
# Do not commit a real token.
GITHUB_TOKEN=

# Optional for the remote pipeline: build a different branch/tag or fork.
REPO_URL=https://github.com/hhdtc/cover-studio.git
REPO_REF=main
