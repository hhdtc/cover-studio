        {
          "id": "aureole-deconstruct",
          "name": "Deconstruction"
        },
        {
          "id": "aureole-float",
          "name": "Floating scene & projection"
        },
        {
          "id": "aureole-annotate",
          "name": "Labels, search & archive"
        },
        {
          "id": "aureole-settings",
          "name": "Config & accessibility"
        }
      ]
    }
